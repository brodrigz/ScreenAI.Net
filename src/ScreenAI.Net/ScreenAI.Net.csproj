<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ScreenAI.Net</AssemblyName>
    <RootNamespace>ScreenAI</RootNamespace>
    <PackageId>ScreenAI.Net</PackageId>
    <Version>0.2.0-preview.1</Version>
    <Authors>ScreenAI.Net contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Unofficial Windows x64 .NET wrapper for a caller-supplied Chrome Screen AI OCR component. No browser, Python runtime, or cloud service required.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ocr;screenai;interop;windows</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
